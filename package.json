{
  "name": "trailie-crew",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.19"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/with-local-supabase.mjs next dev",
    "build": "next build",
    "build:local": "node scripts/with-local-supabase.mjs next build",
    "start": "next start",
    "db:reset:local": "node scripts/reset-local-database.mjs",
    "migrations:verify": "node scripts/verify-migrations.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:openai:smoke": "node scripts/openai-smoke.mjs",
    "test:memory:smoke": "node scripts/memory-smoke.mjs",
    "test:planning:smoke": "node scripts/planning-smoke.mjs",
    "test:itinerary:smoke": "node scripts/itinerary-smoke.mjs",
    "test:revision:smoke": "node scripts/revision-smoke.mjs",
    "test:provider:acceptance": "node scripts/provider-reliability-acceptance.mjs",
    "test:interruption:acceptance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/workflow-interruption-acceptance.mjs",
    "test:quota:acceptance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/quota-acceptance.mjs",
    "test:infrastructure:acceptance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/infrastructure-acceptance.mjs",
    "test:load:acceptance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/load-acceptance.mjs",
    "test:load:chat": "psql postgresql://postgres:postgres@127.0.0.1:55322/postgres -f scripts/sql/phase-5c-chat-load.sql",
    "test:share:smoke": "vitest run src/features/sharing",
    "test:pdf:smoke": "vitest run src/features/sharing/components/public-itinerary.test.tsx src/app/trips/[roomId]/plans/[version]/print/page.test.tsx",
    "test:calendar:smoke": "vitest run src/features/exports/ics.test.ts src/app/api/trips/[roomId]/plans/[version]/calendar/route.test.ts",
    "test:travel-tools:smoke": "node scripts/travel-tools-smoke.mjs",
    "test:travel-provider:acceptance": "vitest run packages/travel-tools/src packages/trailverse-adapter/src src/server/travel",
    "test:evidence-snapshot:acceptance": "vitest run packages/schemas/src/travel-evidence.test.ts src/server/travel/repository.test.ts src/features/itinerary/worker.test.ts src/features/sharing/components/public-itinerary.test.tsx",
    "test:revision-evidence:acceptance": "vitest run src/server/travel/revision-refresh.test.ts src/features/revisions/worker.test.ts",
    "test:watch": "vitest",
    "supabase": "supabase"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.1",
    "@supabase/supabase-js": "2.110.3",
    "@trailie/schemas": "workspace:*",
    "@trailie/trailverse-adapter": "workspace:*",
    "@trailie/travel-tools": "workspace:*",
    "@trailie/validation": "workspace:*",
    "lucide-react": "^1.24.0",
    "mapbox-gl": "3.26.0",
    "next": "^16.2.10",
    "openai": "6.46.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supabase": "2.109.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
