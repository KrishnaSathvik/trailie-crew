{
  "name": "trailie-crew",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.19"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/with-local-supabase.mjs next dev",
    "build": "next build",
    "build:local": "node scripts/with-local-supabase.mjs next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:openai:smoke": "node scripts/openai-smoke.mjs",
    "test:watch": "vitest",
    "supabase": "supabase"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.1",
    "@supabase/supabase-js": "2.110.3",
    "@trailie/schemas": "workspace:*",
    "@trailie/trailverse-adapter": "workspace:*",
    "@trailie/travel-tools": "workspace:*",
    "@trailie/validation": "workspace:*",
    "lucide-react": "^1.24.0",
    "next": "^16.2.10",
    "openai": "6.46.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supabase": "2.109.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
